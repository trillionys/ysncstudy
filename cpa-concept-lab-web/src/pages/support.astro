---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { CATEGORIES, LIMITS, SUBMIT_INTERVAL_SECONDS } from '../lib/feedback-schema';

const faqs = [
  { q: '앱을 쓰는 데 회원가입이 필요한가요?', a: '아니요. Android 앱은 회원가입·로그인 없이 바로 쓸 수 있습니다. Google 로그인은 이 고객지원 페이지에서 의견을 보내거나 내가 보낸 의견을 볼 때만 필요합니다.' },
  { q: '홈페이지에 로그인하면 앱 학습기록이 연동되나요?', a: '아니요. 홈페이지 로그인 계정과 앱은 연결되어 있지 않습니다. 학습기록은 휴대폰 안에만 저장되며, 앱의 백업 기능으로 옮길 수 있습니다.' },
  { q: '휴대폰을 바꾸면 학습기록을 옮길 수 있나요?', a: '앱의 설정 → 학습 데이터 → 전체 데이터 백업으로 파일을 저장한 뒤, 새 휴대폰의 앱에서 백업 데이터 복원을 누르세요.' },
  { q: '문제나 해설에 오류가 있어요.', a: '로그인 후 ‘문제 및 해설 오류’ 유형으로 알려 주세요. 앱 문제 화면에 표시되는 문제 ID를 함께 적어 주시면 더 빨리 확인할 수 있습니다. 앱 안의 오류 신고 버튼으로도 보낼 수 있습니다.' },
  { q: '보낸 의견에 답장을 받을 수 있나요?', a: '처리 상태(접수됨·검토 중·처리 완료)는 ‘내가 보낸 의견’에서 확인할 수 있습니다. 개별 답장이 필요한 경우 운영자가 로그인 계정 이메일로 연락할 수 있습니다.' },
  { q: '유료인가요?', a: '현재 앱의 모든 기능은 무료이며 결제·인앱 구매·광고가 없습니다.' },
];
---
<Base title="고객지원 및 의견 보내기" description="CPA Concept Lab 고객지원: 자주 묻는 질문, 연락처, 의견 보내기(Google 로그인).">
  <section class="page-head">
    <div class="container narrow">
      <h1>고객지원 및 의견 보내기</h1>
      <p>
        CPA Concept Lab을 사용하면서 느낀 점이나 개선 아이디어를 자유롭게 남겨주세요.<br />
        문제 오류, 새로운 기능 제안, 사용성에 관한 의견까지 더 나은 앱을 만드는 데 참고하겠습니다.
      </p>
    </div>
  </section>

  <div class="container narrow support">
    <!-- 로그인 영역: 상태에 따라 아래 중 하나만 보임 -->
    <section class="card" id="auth-panel" aria-live="polite" aria-busy="true">
      <div data-view="loading">
        <p class="muted" style="margin:0">로그인 상태를 확인하고 있습니다…</p>
      </div>

      <div data-view="config" hidden>
        <p class="notice warn" style="margin:0">고객지원 의견 기능을 준비하고 있습니다. 그동안은 아래 연락처로 문의해 주세요.</p>
      </div>

      <div data-view="signed-out" hidden>
        <h2 class="panel-title">의견을 보내려면 로그인해 주세요</h2>
        <p>피드백 작성 및 제출 내역 확인을 위해 Google 로그인이 필요합니다.</p>
        <button class="btn btn-google" type="button" data-action="login">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
          Google 계정으로 로그인
        </button>
        <div data-el="popup-help" class="notice warn small" hidden>
          <p style="margin:0 0 8px">브라우저가 로그인 팝업 창을 막았습니다. 팝업을 허용하거나, 팝업 없이 이 화면에서 로그인하세요.</p>
          <button class="btn btn-secondary btn-sm" type="button" data-action="login-redirect">팝업 없이 로그인</button>
        </div>
        <p class="small muted login-note">
          로그인하면 Google 계정의 이름·이메일·프로필 사진과 고유번호(UID)가 의견 처리에 사용됩니다. 이메일은 다른 이용자에게 공개되지 않습니다.
          자세한 내용은 <a href="/privacy">개인정보 처리방침</a>을 확인하세요.
        </p>
      </div>

      <div data-view="signed-in" hidden>
        <div class="profile">
          <img data-el="avatar" alt="" width="44" height="44" referrerpolicy="no-referrer" hidden />
          <div class="who">
            <span class="small muted">로그인됨</span>
            <strong data-el="name"></strong>
          </div>
          <button class="btn btn-ghost btn-sm" type="button" data-action="logout">로그아웃</button>
        </div>
      </div>

      <p data-el="auth-msg" class="notice error small" role="alert" hidden></p>
    </section>

    <!-- 로그인 후에만 보이는 영역(실제 데이터 보호는 Firestore 보안 규칙이 담당) -->
    <div data-view="member" hidden>
      <nav class="tabs" aria-label="고객지원 메뉴">
        <button type="button" class="tab" data-tab="write" aria-pressed="true">새로운 의견 작성</button>
        <button type="button" class="tab" data-tab="mine" aria-pressed="false">내가 보낸 의견</button>
      </nav>

      <section class="card" data-pane="write" aria-labelledby="write-title">
        <h2 id="write-title" class="panel-title">새로운 의견 작성</h2>
        <form data-el="form" novalidate>
          <div class="field">
            <label for="f-category">의견 유형<span class="req" aria-hidden="true">*</span></label>
            <select id="f-category" name="category" required aria-describedby="e-category">
              <option value="">선택해 주세요</option>
              {CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}
            </select>
            <p class="err" id="e-category" data-err="category"></p>
          </div>
          <div class="field">
            <label for="f-title">제목<span class="req" aria-hidden="true">*</span></label>
            <input id="f-title" name="title" type="text" required maxlength={LIMITS.title} autocomplete="off" enterkeyhint="next" aria-describedby="c-title e-title" />
            <p class="hint"><span>한 줄로 요약해 주세요.</span><span id="c-title" data-count="title">0 / {LIMITS.title}</span></p>
            <p class="err" id="e-title" data-err="title"></p>
          </div>
          <div class="field">
            <label for="f-message">상세 내용<span class="req" aria-hidden="true">*</span></label>
            <textarea id="f-message" name="message" required maxlength={LIMITS.message} aria-describedby="c-message e-message"></textarea>
            <p class="hint"><span>재현 방법·기대한 결과를 적어 주시면 도움이 됩니다. 개인정보는 적지 마세요.</span><span id="c-message" data-count="message">0 / {LIMITS.message.toLocaleString()}</span></p>
            <p class="err" id="e-message" data-err="message"></p>
          </div>
          <div class="grid grid-2">
            <div class="field">
              <label for="f-qid">관련 문제 ID <span class="muted small">(선택)</span></label>
              <input id="f-qid" name="relatedQuestionId" type="text" maxlength={LIMITS.relatedQuestionId} autocomplete="off" autocapitalize="characters" placeholder="예: IA-0123-Q2" aria-describedby="e-relatedQuestionId" />
              <p class="err" id="e-relatedQuestionId" data-err="relatedQuestionId"></p>
            </div>
            <div class="field">
              <label for="f-ver">앱 버전 <span class="muted small">(선택)</span></label>
              <input id="f-ver" name="appVersion" type="text" maxlength={LIMITS.appVersion} autocomplete="off" inputmode="decimal" placeholder="예: 1.0.8" aria-describedby="e-appVersion" />
              <p class="err" id="e-appVersion" data-err="appVersion"></p>
            </div>
          </div>
          <p class="small muted">
            제출하면 <a href="/terms" target="_blank" rel="noopener">이용약관</a>과 <a href="/privacy" target="_blank" rel="noopener">개인정보 처리방침</a>에 따라 처리됩니다.
            같은 계정은 {SUBMIT_INTERVAL_SECONDS}초에 한 번 제출할 수 있습니다.
          </p>
          <p data-el="form-msg" class="notice small" role="status" hidden></p>
          <button class="btn btn-primary submit" type="submit" data-el="submit">의견 보내기</button>
        </form>

        <div data-el="done" hidden tabindex="-1">
          <p class="notice success done-msg">의견이 정상적으로 접수되었습니다.</p>
          <div class="btn-row">
            <button class="btn btn-primary" type="button" data-action="go-mine">내가 보낸 의견 확인</button>
            <button class="btn btn-secondary" type="button" data-action="new">새 의견 작성</button>
          </div>
        </div>
      </section>

      <section class="card" data-pane="mine" aria-labelledby="mine-title" hidden>
        <div class="mine-head">
          <h2 id="mine-title" class="panel-title">내가 보낸 의견</h2>
          <button class="btn btn-ghost btn-sm" type="button" data-action="refresh">새로고침</button>
        </div>
        <p class="small muted">최신순 · 처리 상태는 운영자가 갱신합니다.</p>
        <p data-el="list-msg" class="notice small" role="status" hidden></p>
        <ul class="items" data-el="list"></ul>
        <p data-el="empty" class="muted empty" hidden>아직 작성한 의견이 없습니다.</p>
        <button class="btn btn-secondary btn-sm more" type="button" data-action="more" hidden>더 보기</button>
      </section>

      <section class="card account" id="account" aria-labelledby="account-title">
        <h2 id="account-title" class="panel-title">계정 삭제</h2>
        <p class="small">이 홈페이지의 로그인 계정을 삭제합니다. 내가 보낸 의견을 <strong>모두 먼저 삭제</strong>한 뒤 계정을 삭제하며, 되돌릴 수 없습니다. Google 계정 자체와 Android 앱의 학습기록은 삭제되지 않습니다.</p>
        <p data-el="account-msg" class="notice small" role="status" hidden></p>
        <button class="btn btn-danger btn-sm" type="button" data-action="delete-account">계정과 의견 모두 삭제</button>
      </section>
    </div>

    <!-- 공개 영역: 로그인 없이 보임 -->
    <section class="card" aria-labelledby="contact-title">
      <h2 id="contact-title" class="panel-title">연락처</h2>
      <Contact />
      <p class="small muted" style="margin:0">개인정보 관련 문의와 데이터 삭제 요청은 <a href="/privacy#p12">개인정보 처리방침</a>과 <a href="/data-deletion">데이터 삭제 안내</a>를 참고하세요.</p>
    </section>

    <section aria-labelledby="faq-title" class="faq">
      <h2 id="faq-title" class="panel-title">자주 묻는 질문</h2>
      {faqs.map((f) => (
        <details class="card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
  <div style="height:72px"></div>
</Base>

<style>
  .support { display: grid; gap: 16px; }
  .panel-title { font-size: 1.2rem; margin-bottom: 8px; }
  .btn-google { background: var(--white); color: var(--text); border: 1px solid var(--border); width: 100%; max-width: 360px; box-shadow: var(--shadow); }
  .btn-google:hover { border-color: var(--blue); color: var(--text); }
  [data-el='popup-help'] { margin-top: 12px; }
  .login-note { margin: 14px 0 0; }
  .profile { display: flex; align-items: center; gap: 12px; }
  .profile img { border-radius: 50%; border: 1px solid var(--border); }
  .who { display: grid; line-height: 1.35; flex: 1; min-width: 0; }
  .who strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  [data-el='auth-msg'] { margin: 12px 0 0; }
  [data-view='member'] { display: grid; gap: 16px; }
  [data-view='member'][hidden] { display: none; }
  .tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; background: var(--white); border: 1px solid var(--border); border-radius: 999px; padding: 5px; }
  .tab { min-height: 44px; border: 0; border-radius: 999px; background: transparent; font: inherit; font-weight: 700; color: var(--muted); cursor: pointer; }
  .tab[aria-pressed='true'] { background: var(--navy); color: #fff; }
  .submit { width: 100%; }
  @media (min-width: 640px) { .submit { width: auto; min-width: 200px; } }
  .done-msg { font-weight: 700; margin-bottom: 16px; }
  .mine-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .mine-head .panel-title { margin: 0; }
  .items { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 10px; }
  .empty { margin: 12px 0 0; }
  .more { margin-top: 12px; }
  .account p:last-of-type { margin-bottom: 12px; }
  .faq { display: grid; gap: 10px; }
  .faq .card { padding: 0; box-shadow: none; }
  .faq summary { cursor: pointer; padding: 16px 20px; font-weight: 700; min-height: 48px; list-style-position: inside; }
  .faq details p { padding: 0 20px 16px; margin: 0; color: var(--muted); }
</style>

<style is:global>
  .fb-item { border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--white); }
  .fb-item summary { list-style: none; cursor: pointer; padding: 14px 16px; display: grid; gap: 4px; min-height: 48px; }
  .fb-item summary::-webkit-details-marker { display: none; }
  .fb-item .fb-title { font-weight: 700; color: var(--navy-dark); }
  .fb-item .fb-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 0.85rem; color: var(--muted); }
  .fb-item .fb-body { padding: 0 16px 16px; border-top: 1px solid var(--border); }
  .fb-item .fb-message { white-space: pre-wrap; margin: 12px 0; }
  .fb-item dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; font-size: 0.9rem; margin: 0 0 12px; }
  .fb-item dt { color: var(--muted); }
  .fb-item dd { margin: 0; }
</style>

<script>
  import '../scripts/support';
</script>
