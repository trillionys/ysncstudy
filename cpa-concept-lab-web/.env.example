# Firebase 웹 앱 구성정보(클라이언트 공개값). 비밀키가 아닙니다.
# ⚠️ 서비스 계정 키·Admin SDK private_key·OAuth Client Secret 은 여기(PUBLIC_*)에 절대 넣지 마세요.
#    PUBLIC_ 로 시작하는 값은 빌드 결과(브라우저 JavaScript)에 그대로 들어갑니다.
# 값 위치: Firebase Console → 프로젝트 설정(톱니바퀴) → 내 앱 → 웹 앱 → SDK 설정 및 구성 → 구성
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=cpa-concept-lab.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=cpa-concept-lab
PUBLIC_FIREBASE_STORAGE_BUCKET=cpa-concept-lab.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# 선택: 사이트 주소를 직접 지정(비우면 Netlify 가 알려 주는 주소 사용)
PUBLIC_SITE_URL=

# 개발·테스트 전용: true 면 로컬 Firebase 에뮬레이터에 연결(배포 환경에서는 설정하지 마세요)
PUBLIC_FIREBASE_USE_EMULATORS=
